<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MvcJogos</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Acesso ao SQLite (ADO.NET) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- O banco vai junto com o programa compilado (pasta bin/.../db) -->
    <None Update="db/jogos.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
